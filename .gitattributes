# Normalise line endings so Windows editors (Visual Studio, Notepad) do not
# show every line of a file as changed when only CRLF/LF differs.
#
# This was added after LICENSE appeared as "21 insertions, 21 deletions" when
# the text was byte-identical apart from newlines.

# Default: treat everything as text, store LF in the repository,
# and check out with the platform's native endings.
* text=auto

# Be explicit for the file types in this repo.
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
LICENSE  text eol=lf
_headers text eol=lf

# Never touch these.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.ico    binary
*.woff   binary
*.woff2  binary
