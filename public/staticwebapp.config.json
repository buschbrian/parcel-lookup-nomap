{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/_headers"]
  },
  "routes": [
    {
      "route": "/_headers",
      "statusCode": 404,
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/business-licensing",
      "rewrite": "/business-licensing.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/business-licensing.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), camera=(), microphone=(), payment=()",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    "Content-Security-Policy": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src https://services9.arcgis.com https://hazards.fema.gov; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self' https://maps-millcrk.hub.arcgis.com https://*.millcreekut.gov"
  }
}
