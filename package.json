{
  "name": "millcreek-property-lookup",
  "version": "2026.08.13",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.15.0",
    "npm": "10.9.2"
  },
  "description": "Millcreek Property Lookup: two accessible, text-only municipal lookups, built with Vite.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:python && npm run test:e2e",
    "test:unit": "node --test tests/unit.test.mjs tests/service-contract.test.mjs",
    "test:python": "python -m unittest tests/test_flood_rank.py",
    "test:e2e": "npm run build && playwright test",
    "test:production": "playwright test --config playwright.production.config.mjs",
    "check:services": "node scripts/check-services.mjs",
    "check:deployment": "node scripts/check-deployment.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "vite": "8.2.2"
  }
}
