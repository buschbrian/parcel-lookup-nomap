.vs/
__pycache__/
*.pyc
node_modules/
playwright-report/
test-results/

# Vite build output (ADR-0001). The deployed artifact is built, never committed.
# It was briefly tracked on main in 28f7543 and untracked again in ca2a5b2; if it
# reappears in `git status`, something has committed a build.
dist/

# Attorney review material. Kept out of git deliberately: this repository is public
# on GitHub, so committing it would publish it. The whole directory is ignored, not
# named files — the one-page review was committed in 278d895 while its sibling was
# ignored, and a per-file list is what allowed that. The documents stay on disk.
counsel-review/

# Release-candidate smoke run (`npm run test:production`). The JSON evidence is
# sanitized by construction — counts and timings, never result content — but it
# describes one deployment at one moment and belongs with the release record, not
# in the repository.
test-results-production/
production-evidence/
service-contract-report.json

# Draft emails to counsel, records, IT and DNS. Kept beside the project so they
# are easy to find, deliberately not committed: they are correspondence rather
# than code, they name individuals, and their contents change as conversations
# move. The requests they are drawn from live in tasks/todo.md, which is the
# record. Ignore the directory rather than the files inside it - naming files
# individually is exactly how the attorney review document ended up committed.
emails/
